{
  "name": "stem-mqtt-client",
  "version": "0.3.0",
  "description": "An MQTT 3.1.1 / MQTT 5.0 client implemented in Rust and exposed to Node.js via napi-rs.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorinirimies/stem-mqtt.git"
  },
  "napi": {
    "binaryName": "mqtt-client",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts",
    "artifacts": "napi artifacts",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2",
    "@napi-rs/cross-toolchain": "^1.0.3"
  },
  "optionalDependencies": {
    "@napi-rs/cross-toolchain-x64-target-aarch64": "^1.0.3"
  },
  "packageManager": "npm@11.0.0"
}
