name: stem_mqtt
description: >-
  MQTT 3.1.1 / 5.0 client and broker with a Rust core (UniFFI bindings): QoS 0/1/2, TLS,
  WebSocket, shared subscriptions, MQTT 5 enhanced auth. Builds the native library with cargo.
version: @VERSION@
repository: https://github.com/sorinirimies/stem-mqtt
issue_tracker: https://github.com/sorinirimies/stem-mqtt/issues
topics:
  - mqtt
  - broker
  - networking
  - iot
environment:
  sdk: ">=3.9.0 <4.0.0"
dependencies:
  ffi: ^2.1.0
  hooks: ^1.0.0
  code_assets: ^1.0.0
